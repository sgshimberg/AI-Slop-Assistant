# Copy this file to .env and fill in real values. Never commit .env.
# See CREDENTIALS.md for how to obtain each of these.

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MY_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# Optional: required for any message YOU initiate outside an active WhatsApp
# session (this is required for the eventual 4AM digest). Leave blank to send
# freeform text instead, which only works within an open session (e.g. right
# after you send the sandbox join code). See CREDENTIALS.md.
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARIABLES=

# --- Google (Calendar + Tasks share one OAuth client) ---
GOOGLE_CLIENT_SECRET_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json
# Dedicated 'testing' calendar (see scripts/create_test_calendar.py) — used by the
# Phase 1 test suite and demo script instead of your primary calendar.
GOOGLE_TEST_CALENDAR_ID=

# --- Moodle ---
MOODLE_BASE_URL=https://moodle-courses2527.wolfware.ncsu.edu/
# Preferred: a web service token from Preferences > Security keys (if your institution allows it)
MOODLE_TOKEN=
# Fallback if MOODLE_TOKEN is unavailable: the personal calendar export (ICS/webcal) URL
# from Moodle > Calendar > Export calendar > "This calendar" > get URL to a calendar feed.
MOODLE_ICS_URL=

# --- Weather ---
OPENWEATHER_API_KEY=
WEATHER_CITY=Raleigh,US

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
